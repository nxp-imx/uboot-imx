if ARCH_IMX9

config AHAB_BOOT
    bool "Support i.MX9 AHAB features"
    help
    This option enables the support for AHAB secure boot.

config SPL_IMX_BBSM
    bool "Support BBSM Tamper Detection feature"
	depends on IMX93 || IMX95
	default n
    help
      This option enables the support for BBSM Tamper Detection. This option is
      only supported on i.MX93 and i.MX95.

config IMX_CRRM
    bool "Support i.MX9 cyber resilient recovery module (CRRM)"
	depends on IMX94 || IMX952
	select PSCI_BOARD_REBOOT
    help
      This option enables the support for IMX CRRM.

config IMX_CRRM_PROTECT_SIZE
	hex "Specify the size for XSPI protected image"
	depends on IMX_CRRM
	default 0x400000

config IMX_CRRM_AWDT_TIMEOUT
	int "Specify the initialized timeout(ms) for CRRM AWDT timer"
	depends on IMX_CRRM
	default 300000

config IMX_CRRM_SELFTEST
    bool "Enable CRRM self test routing in SPL/u-boot"
    help
      This option enables CRRM self test. No CRRM OS is needed in the test.

config IMX9
	bool
	select CPU
	select CPU_IMX
	select HAS_CAAM
	select ROM_UNIFIED_SECTIONS
	imply IMX_TMU

config IMX93
	bool
	select IMX9
	select ARCH_MISC_INIT
	select ARMV8_SPL_EXCEPTION_VECTORS
	select SYS_FSL_ERRATUM_052357

config IMX937
	bool
	select IMX952

config IMX91
	bool
	select IMX9
	select ARCH_MISC_INIT
	select ARMV8_SPL_EXCEPTION_VECTORS
	select SYS_FSL_ERRATUM_052357

config IMX95_A0
	bool "Support for i.MX95 A0 silicon version"

config IMX95
	bool
	select ARCH_MISC_INIT
	select ARMV8_SPL_EXCEPTION_VECTORS
	select IMX9
	select DM_MAILBOX
	select SCMI_FIRMWARE
	select SPL_IMX_CONTAINER_USE_TRAMPOLINE
	select IMX_PQC_SUPPORT if !IMX95_A0

config IMX94
	bool
	select ARCH_MISC_INIT
	select ARMV8_SPL_EXCEPTION_VECTORS
	select DM_MAILBOX
	select IMX9
	select IMX_PQC_SUPPORT
	select SCMI_FIRMWARE
	select SPL_IMX_CONTAINER_USE_TRAMPOLINE

config IMX952
	bool
	select ARCH_MISC_INIT
	select ARMV8_SPL_EXCEPTION_VECTORS
	select IMX9
	select DM_MAILBOX
	select SCMI_FIRMWARE
	select SPL_IMX_CONTAINER_USE_TRAMPOLINE
	select IMX_PQC_SUPPORT

