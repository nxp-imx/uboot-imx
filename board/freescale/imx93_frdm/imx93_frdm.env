#include <env/nxp/imx_env.env>

/* Persistent A/B state */
BOOT_ORDER=A B
BOOT_A_LEFT=3
BOOT_B_LEFT=3
fit_conf=conf-imx93-11x11-frdm.dtb

/********************************************************
 * Strict FIT + signed container + signed bootscript only
 ********************************************************/
boot_fit=yes
sec_boot=yes

console=ttyLP0,115200 earlycon

/* Addresses/files used by FIT flow */
cntr_addr=0x98000000
cntr_file=os_cntr_signed.bin
scriptaddr=0x83500000
script=boot.scr
emmc_dev=0
emmc_ack=0
sd_dev=1
mmcdev=0
mmcpart=1

fdt_addr_r=0x83000000
fdt_addr=0x83000000

/********************************************************
 * Commands
 ********************************************************/
loadcntr=fatload mmc ${mmcdev}:${mmcpart} ${cntr_addr} ${cntr_file}
loadbootscript=fatload mmc ${mmcdev}:${mmcpart} ${scriptaddr} ${script}
auth_bs=auth_cntr ${scriptaddr}
bootscript=echo Running bootscript from mmc ...; if run loadbootscript; then if run auth_bs; then source ${scriptaddr}; else echo ERR: failed to authenticate bootscript; reset; fi; else echo ERR: failed to load bootscript; reset; fi

/********************************************************
 * Boot path
 * bootcmd -> bsp_bootcmd -> fit_bootcmd -> bootscript
 ********************************************************/
fit_conf=conf-imx93-11x11-frdm-ld.dtb
fit_bootcmd=if run loadcntr; then run bootscript; else echo ERR: cannot load authenticated FIT/container from mmc; reset; fi
bsp_bootcmd=echo Running BSP bootcmd ...; mmc dev ${mmcdev}; if mmc rescan; then run fit_bootcmd; else echo ERR: mmc rescan failed; reset; fi
bootcmd=run bsp_bootcmd
